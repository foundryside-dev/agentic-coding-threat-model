---
import { getCollection } from 'astro:content';
import { ruleHref } from '../scripts/rules-index.mjs';

interface Props {
	id: string;
}

const { id } = Astro.props;
const rules = await getCollection('wardlineRules');
const rule = rules.find((entry) => entry.data.id === id);

if (!rule) throw new Error(`Unknown wardline rule: ${id}`);

const base = import.meta.env.BASE_URL;
---

<a href={ruleHref(base, rule.data)} title={rule.data.summary}>
	<code>{id}</code>
</a>
